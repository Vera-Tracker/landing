# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Prefer the service role key for server-side inserts (never expose to the client).
# Alternatively use the anon key with an insert-only RLS policy (see README).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: used for Open Graph absolute URLs in production
NEXT_PUBLIC_SITE_URL=https://your-domain.com
